{
  "entity": "PurchaseOrder",
  "op": {
    "op": "set_approval",
    "on": "submit",
    "approval": {
      "reset_on": ["base_grand_total"],
      "steps": [
        {"label": "Purchase Manager", "approvers": {"role": "Purchase Manager"},
         "when": "doc.base_grand_total > settings.PurchaseApprovalSettings.first_above"},
        {"label": "Accounts Manager", "approvers": {"role": "Accounts Manager"}, "not_earlier_deciders": true,
         "when": "settings.PurchaseApprovalSettings.second_above > 0.0 && doc.base_grand_total > settings.PurchaseApprovalSettings.second_above"},
        {"label": "Two Accounts Managers", "approvers": {"role": "Accounts Manager"}, "need": 2, "not_earlier_deciders": true,
         "when": "settings.PurchaseApprovalSettings.third_above > 0.0 && doc.base_grand_total > settings.PurchaseApprovalSettings.third_above"}
      ]
    }
  }
}
